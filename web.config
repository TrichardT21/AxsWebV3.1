<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Permite acceder a los scripts PHP del backend sin reescribir -->
        <rule name="Backend Rule" stopProcessing="true">
          <match url="^backend/.*" />
          <action type="None" />
        </rule>
        <!-- Regla para redireccionar todas las rutas del frontend SPA a index.html -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_DIRNAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/AxsReact/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
